# ============================================================
# SSO GEMMATEX - Variables de entorno
# ============================================================

# --- App ---
NODE_ENV=development
PORT=2106
APP_NAME=sso-gemmatex
APP_URL=http://localhost:2106
LOG_LEVEL=debug

# --- Base de datos Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=sso_user
DB_PASSWORD=sso_pass
DB_NAME=sso_gemmatex
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000

# --- pgAdmin (UI DB) ---
PGADMIN_PORT=8080
PGADMIN_EMAIL=admin@gemmatex.local
PGADMIN_PASSWORD=admin

# --- JWT RS256 ---
# Rutas a las llaves generadas con `npm run keys:generate`
JWT_PRIVATE_KEY_PATH=./src/keys/private.pem
JWT_PUBLIC_KEY_PATH=./src/keys/public.pem
JWT_ISSUER=sso.gemmatex.local
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_KID=key-2026-01

# --- Cifrado AES-256-GCM (tokens OAuth y secretos sensibles) ---
# 32 bytes en hex (64 chars). Genera con: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Mail SMTP (verificación email y reset password) ---
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=GEMMATEX SSO
MAIL_FROM_EMAIL=no-reply@gemmatex.com.bo
# Para Templates de email (verificación, reset password, etc)
MAIL_LOGO_URL=https://peru-crane-813567.hostingersite.com/Logos/Logo%20gemmatex%20azul.png
MAIL_BRAND_COLOR="#0b5ed7"
MAIL_FOOTER_LOCATION=La Paz – Bolivia

# URLs del FRONTEND (account.gemmatex.com.bo) para los links de email.
# Placeholder {token} es reemplazado con el token plano antes de enviar.
#
# El frontend extrae el token de la URL y llama a la API del SSO:
#   POST /api/v1/auth/verify-email   { token }
#   POST /api/v1/auth/reset-password { token, new_password }
#
# Producción:
#   https://account.gemmatex.com.bo/verify-email?token={token}
#
# Desarrollo (asume frontend corriendo en puerto 3000):
EMAIL_VERIFY_URL_TEMPLATE=http://localhost:3000/verify-email?token={token}
EMAIL_CHANGE_URL_TEMPLATE=http://localhost:3000/confirm-email-change?token={token}
EMAIL_RESET_URL_TEMPLATE=http://localhost:3000/reset-password?token={token}
EMAIL_INVITATION_URL_TEMPLATE=http://localhost:3000/accept-invitation?token={token}

# --- SMS (verificación teléfono) ---
# Provider: twilio | mock (mock solo desarrollo, imprime en consola)
SMS_PROVIDER=mock
SMS_FROM=+59100000000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Tokens y seguridad ---
PASSWORD_HISTORY_SIZE=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
EMAIL_VERIFY_TTL_HOURS=24
PHONE_VERIFY_TTL_MINUTES=10
PHONE_VERIFY_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_HOURS=1
ADMIN_INVITE_TTL_DAYS=7

# --- Rate limit ---
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_FORGOT_PER_HOUR=3
RATE_LIMIT_REGISTER_PER_HOUR=10

# --- CORS ---
# Orígenes permitidos (coma-separados). Tomado además de applications.allowed_origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://account.gemmatex.com.bo

# --- Jobs (cron) ---
JOBS_ENABLED=true
# Schedule cleanup tokens viejos (default 3am daily)
JOBS_CLEANUP_TOKENS_CRON=0 3 * * *
# Días de retención antes de borrar revocados/expirados
JOBS_CLEANUP_REFRESH_TOKENS_DAYS=90
JOBS_CLEANUP_EMAIL_TOKENS_DAYS=30
JOBS_CLEANUP_PASSWORD_RESETS_DAYS=30
JOBS_CLEANUP_PHONE_VERIFICATIONS_DAYS=30
# Audit logs: retención larga para compliance
JOBS_CLEANUP_AUDIT_LOGS_DAYS=365

# --- Cookies (refresh_token httpOnly para apps type=spa-web) ---
# COOKIE_SECURE=true requiere HTTPS. En dev local con HTTP debe ser false.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
# Path al que aplica la cookie. Limita scope de envío.
COOKIE_REFRESH_PATH=/api/v1/auth
# Dominio opcional. Vacío = host actual. Para compartir entre subdominios: .gemmatex.com.bo
COOKIE_DOMAIN=
