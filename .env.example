# ============================================================
# SSO GEMMATEX - Variables de entorno
# Copia este archivo a `.env` y completa los valores.
# Nunca commitees `.env`.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=2106
APP_NAME=sso-gemmatex
APP_URL=http://localhost:2106
LOG_LEVEL=debug

# --- Base de datos Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=sso_user
DB_PASSWORD=sso_pass
DB_NAME=sso_gemmatex
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000

# --- pgAdmin (UI DB) ---
PGADMIN_PORT=8080
PGADMIN_EMAIL=admin@gemmatex.local
PGADMIN_PASSWORD=admin

# --- JWT RS256 ---
# Rutas a las llaves generadas con `npm run keys:generate`
JWT_PRIVATE_KEY_PATH=./src/keys/private.pem
JWT_PUBLIC_KEY_PATH=./src/keys/public.pem
JWT_ISSUER=sso.gemmatex.local
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_KID=key-2026-01

# --- Cifrado AES-256-GCM (tokens OAuth y secretos sensibles) ---
# 32 bytes en hex (64 chars). Genera con: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Mail SMTP (verificación email y reset password) ---
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=GEMMATEX SSO
MAIL_FROM_EMAIL=no-reply@gemmatex.com.bo

# URLs hacia el frontend para los links de email.
# Placeholder {token} es reemplazado con el token plano.
# Si no hay frontend aún, apunta al endpoint API directamente.
EMAIL_VERIFY_URL_TEMPLATE=http://localhost:2106/api/v1/auth/verify-email?token={token}
EMAIL_CHANGE_URL_TEMPLATE=http://localhost:2106/api/v1/auth/confirm-email-change?token={token}
EMAIL_RESET_URL_TEMPLATE=http://localhost:2106/api/v1/auth/reset-password?token={token}

# --- SMS (verificación teléfono) ---
# Provider: twilio | mock (mock solo desarrollo, imprime en consola)
SMS_PROVIDER=mock
SMS_FROM=+59100000000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Tokens y seguridad ---
PASSWORD_HISTORY_SIZE=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
EMAIL_VERIFY_TTL_HOURS=24
PHONE_VERIFY_TTL_MINUTES=10
PHONE_VERIFY_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_HOURS=1
ADMIN_INVITE_TTL_DAYS=7

# --- Rate limit ---
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_FORGOT_PER_HOUR=3
RATE_LIMIT_REGISTER_PER_HOUR=10

# --- CORS ---
# Orígenes permitidos (coma-separados). Tomado además de applications.allowed_origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
